  tenantId            String
  createdAt           DateTime @default(now())

  @@index([productId])
  @@index([tenantId])
}

model ShopReorderSuggestion {
  id              String               @id @default(cuid())
  productId       String
  productName     String
  productSku      String
  currentStock    Int
  reorderPoint    Int
  suggestedQty    Int
  avgDailySales   Decimal
  daysOfStock     Int
  lastSaleDate    DateTime?
  status          ShopSuggestionStatus @default(PENDING)
  purchaseOrderId String?
  processedById   String?
  processedAt     DateTime?
  rejectionReason String?
  tenantId        String
  createdAt       DateTime             @default(now())

  @@index([status])
  @@index([tenantId])
}

model ShopSupplier {
  id             String              @id @default(cuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  paymentTermDays Int                @default(30)
  leadTimeDays   Int                 @default(7)
  totalOrders    Int                 @default(0)
  onTimeDelivery Decimal             @default(100)
  purchaseOrders ShopPurchaseOrder[]
  tenantId       String
  status         String              @default("ACTIVE")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId])
}

model ShopPurchaseOrder {
  id             String                  @id @default(cuid())
  orderNumber    String                  @unique
  supplierId     String
  supplier       ShopSupplier            @relation(fields: [supplierId], references: [id])
  subtotal       Decimal
  taxAmount      Decimal                 @default(0)
  shippingAmount Decimal                 @default(0)
  total          Decimal
  status         ShopPOStatus            @default(DRAFT)
  expectedDate   DateTime?
  receivedDate   DateTime?
  notes          String?
  isTaxEnabled   Boolean                 @default(false)
  items          ShopPurchaseOrderItem[]
  createdById    String
  tenantId       String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([orderNumber])
  @@index([supplierId])
  @@index([tenantId])
}

model ShopPurchaseOrderItem {
  id              String            @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   ShopPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  productSku      String
  quantity        Decimal
  receivedQty     Decimal           @default(0)
  unitCost        Decimal
  taxRate         Decimal           @default(0)
  taxAmount       Decimal           @default(0)
  lineTotal       Decimal

  @@index([purchaseOrderId])
}

model ShopTaxCategory {
  id          String   @id @default(cuid())
  name        String
  rate        Float
  description String?
  isDefault   Boolean  @default(false)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  spareParts  SparePart[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// ============================================================================
// EXPORT MODULE: Vehicle Trading & Logistics
// ============================================================================

enum ExportStatus {
  DRAFT
  BID_PENDING
  BID_ACCEPTED
  WON_AT_AUCTION
  IN_YARD
  PREP_IN_PROGRESS
  INSPECTION_BOOKED
  INSPECTION_PASSED
  INSPECTION_FAILED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  SOLD
  RESERVED
}

enum DocStatus {
  PENDING
  APPLIED
  RECEIVED
  TRANSLATED
}

enum ExportBidStatus {
  PENDING
  APPROVED
  REJECTED
  WON
  LOST
}

enum ExportShipmentStatus {
  BOOKED
  SAILED
  ARRIVED
}

enum YardJobType {
  REPAIR
  CLEANING
  INSPECTION_PREP
  VANNING
}

enum YardJobStatus {
  TODO
  IN_PROGRESS
  DONE
}

model ExportCustomer {
  id              String        @id @default(cuid())
  tenantId        String
  
  name            String
  email           String
  password        String?
  phone           String?
  company         String?
  country         String?
  address         String?
  
  vehicles        ExportVehicle[]
  bids            ExportBid[]
  favorites       ExportFavorite[]
  wallet          ExportWallet?
  quoteRequests   ExportQuoteRequest[]

  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([email])
}

model ExportVehicle {
  id              String       @id @default(cuid())
  tenantId        String
  
  // -- Identity --
  stockNumber     String       @unique
  chassisNumber   String?      @unique
  make            String
  model           String
  year            Int
  month           Int?
  engineCode      String?
  fuelType        String?
  color           String?
  steering        String       @default("RHD")
  transmission    String?
  mileage         Int?
  engineCc        Int?
  bodyType        String?
  driveType       String?
  seats           Int?
  doors           Int?
  
  // -- Auction Data --
  auctionHouse    String?
  auctionDate     DateTime?
  lotNumber       String?
  auctionGrade    String?
  auctionSheetUrl String?
  
  // -- Financials --
  purchasePrice   Decimal      @default(0)
  auctionFee      Decimal      @default(0)
  transportCost   Decimal      @default(0)
  repairCost      Decimal      @default(0)
  inspectionCost  Decimal      @default(0)
  shippingCost    Decimal      @default(0)
  
  fobPrice        Decimal      @default(0)
  cifPrice        Decimal      @default(0)
  currency        String       @default("JPY")
  
  // -- Status & Location --
  status          ExportStatus @default(DRAFT)
  location        String?
  isPublished     Boolean      @default(false)
  
  // -- Compliance --
  shakenStatus    DocStatus    @default(PENDING)
  mashoStatus     DocStatus    @default(PENDING)
  exportCertUrl   String?
  jaaiStatus      DocStatus    @default(PENDING)
  jaaiCertUrl     String?

  // -- Relations --
  customerId      String?
  customer        ExportCustomer? @relation(fields: [customerId], references: [id])
  
  shipmentId      String?
  shipment        ExportShipment? @relation(fields: [shipmentId], references: [id])
  
  bids            ExportBid[]
  yardJobs        YardJob[]
  photos          ExportVehiclePhoto[]
  favorites       ExportFavorite[]
  
  // -- Phase 5: Docs & Invoice --
  documents       DocumentDispatch?
  invoice         ExportInvoice?
  quoteRequests   ExportQuoteRequest[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([make, model])
  @@index([isPublished])
}

model ExportFavorite {
  id              String        @id @default(cuid())
  tenantId        String
  customerId      String
  customer        ExportCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         ExportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([customerId, vehicleId])
  @@index([tenantId])
  @@index([customerId])
  @@index([vehicleId])
}


model ExportVehiclePhoto {
  id              String        @id @default(cuid())
  vehicleId       String
  vehicle         ExportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url             String
  tag             String?
  isPublic        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  
  @@index([vehicleId])
}

model ExportBid {
  id              String          @id @default(cuid())
  tenantId        String
  
  vehicleId       String?
  vehicle         ExportVehicle?  @relation(fields: [vehicleId], references: [id])
  
  customerId      String
  customer        ExportCustomer  @relation(fields: [customerId], references: [id])
  
  requestedMake   String
  requestedModel  String
  maxBudget       Decimal
  currency        String          @default("JPY")
  notes           String?
  
  status          ExportBidStatus @default(PENDING)
  proxyBidStatus  String?       // PENDING, ACTIVE, OUTBID, WON, LOST
  adminNotes      String?

  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

model ExportShipment {
  id              String                @id @default(cuid())
  tenantId        String
  shipmentNumber  String                @unique
  
  vesselName      String
  voyageNumber    String
  shippingLine    String
  
  departurePort   String
  destinationPort String
  
  etd             DateTime
  eta             DateTime
  
  billOfLading    String?
  blUrl           String?
  consignee       String?
  
  status          ExportShipmentStatus  @default(BOOKED)
  
  vehicles        ExportVehicle[]
  
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([tenantId])
  @@index([destinationPort])
}

model ExportStoreConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  
  // Branding
  storeName       String   @default("My Auto Exporter")
  tagline         String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#2563eb") // Blue-600
  secondaryColor  String?
  
  // Hero Section
  heroImageUrl    String?
  heroTitle       String?
  heroSubtitle    String?
  // Store JSON of slider items: { id, imageUrl, title, subtitle, buttonText, buttonLink }[]
  heroSlides      Json?
  
  // Contact
  contactEmail    String?
  contactPhone    String?
  whatsappNumber  String?
  address         String?
  
  // Social
  facebookUrl     String?
  instagramUrl    String?
  
  // Promo Banners (JSON: { id, imageUrl, title, link, bgColor }[])
  promoBanners    Json?
  
  // Featured Categories (JSON: { name, slug, imageUrl }[])
  featuredCategories Json?
  
  // Custom Pages Content
  aboutUs         Json?   // { story, mission, stats: [], values: [] }
  services        Json?   // { items: [{ title, description, icon, link }] }
  
  // New Config Fields
  companyProfile      Json? // { title, content, foundedYear, employees }
  bankDetails         Json? // { bankName, accountName, accountNumber, swiftCode, branch }
  faqItems            Json? // [{ category, question, answer }]
  howToBuyStockSteps  Json? // [{ step, title, description, icon }]
  howToBidSteps       Json? // [{ step, title, description, icon }]
  
  contactPage         Json? // { title, subtitle, mapUrl, businessHours }
  
  // Bidding Settings
  requireDeposit  Boolean @default(true)   // Require deposit before bidding
  minimumDeposit  Decimal @default(1000)   // Minimum deposit amount (USD)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model YardJob {
  id              String        @id @default(cuid())
  vehicleId       String
  vehicle         ExportVehicle @relation(fields: [vehicleId], references: [id])
  
  title           String
  type            YardJobType
  status          YardJobStatus @default(TODO)
  
  assignedTo      String?
  completedAt     DateTime?
  
  notes           String?
  proofPhotos     String[]
  
  // Costs
  cost            Decimal       @default(0) // Labor cost
  materials       YardMaterial[]

  
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
}

// -----------------------------------------------------------------------------
// Phase 5: New Models (Wallet, Invoice, Docs, Materials)
// -----------------------------------------------------------------------------

model ExportWallet {
  id            String   @id @default(cuid())
  customerId    String   @unique
  customer      ExportCustomer @relation(fields: [customerId], references: [id])
  tenantId      String
  
  balance       Decimal  @default(0)
  currency      String   @default("USD")
  
  transactions  ExportWalletTransaction[]
  
  updatedAt     DateTime @updatedAt
  
  @@index([tenantId])
}

model ExportWalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  wallet        ExportWallet @relation(fields: [walletId], references: [id])
  tenantId      String
  
  amount        Decimal
  type          String   // DEPOSIT, REFUND, BID_LOCK, INVOICE_PAYMENT
  reference     String?  // Bank Slip ID or Bid ID
  proofUrl      String?  // Receipt Image URL
  status        String   // PENDING, CLEARED, REJECTED
  
  description   String?
  adminNote     String?  // Rejection reason or internal note
  
  createdAt     DateTime @default(now())
  
  @@index([walletId])
  @@index([tenantId])
}

model DocumentDispatch {
  id            String   @id @default(cuid())
  vehicleId     String   @unique
  vehicle       ExportVehicle @relation(fields: [vehicleId], references: [id])
  tenantId      String
  
  courierName   String   // DHL, FedEx
  trackingNumber String
  recipientName String
  recipientAddress String
  sentDate      DateTime @default(now())
  status        String   // IN_TRANSIT, DELIVERED
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([vehicleId])
}

model YardMaterial {
  id            String   @id @default(cuid())
  yardJobId     String
  yardJob       YardJob  @relation(fields: [yardJobId], references: [id])
  tenantId      String
  
  partName      String   // Or link to SparePart if needed later
  quantity      Int
  unitCost      Decimal
  totalCost     Decimal
  
  createdAt     DateTime @default(now())
  
  @@index([yardJobId])
}

model ExportInvoice {
  id            String   @id @default(cuid())
  vehicleId     String   @unique
  vehicle       ExportVehicle @relation(fields: [vehicleId], references: [id])
  tenantId      String
  
  invoiceNumber String   // VE-INV-YYYY-NNN
  
  // CIF Breakdown snapshot
  purchasePrice Decimal
  auctionFee    Decimal
  transportCost Decimal
  shippingCost  Decimal
  inspectionCost Decimal
  yardCost      Decimal
  commission    Decimal
  otherCost     Decimal
  
  totalAmount   Decimal
  currency      String
  
  status        String   // DRAFT, SENT, PAID
  dueDate       DateTime?
  paidAt        DateTime?
  
  items         ExportInvoiceItem[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([vehicleId])
  @@index([tenantId])
}

model ExportInvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       ExportInvoice @relation(fields: [invoiceId], references: [id])
  
  description   String
  amount        Decimal
  
  createdAt     DateTime @default(now())
  
  @@index([invoiceId])
}

// ============================================================================
// VEHICLE EXPORT: REQUESTS & CRM
// ============================================================================

enum RequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  FULFILLED
  LOST
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}

model VehicleRequest {
  id              String          @id @default(cuid())
  ticketNumber    Int             @default(autoincrement())
  
  // Customer Details
  customerName    String
  email           String
  phone           String?
  budget          String?

  // Vehicle Requirements
  vehicleDetails  Json            // Flexible JSON for make, model, year, etc.
  
  // Workflow
  status          RequestStatus   @default(NEW)
  priority        RequestPriority @default(MEDIUM)
  
  // Assignment
  assignedToUserId String?
  assignedToUser   User?          @relation("AssignedVehicleRequests", fields: [assignedToUserId], references: [id])
  
  storeSlug       String
  notes           RequestNote[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([storeSlug])
  @@index([status])
  @@index([assignedToUserId])
  @@unique([ticketNumber])
}

model RequestNote {
  id              String          @id @default(cuid())
  content         String
  
  requestId       String
  request         VehicleRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  authorId        String?         // Optional: could be system or deleted user
  
  createdAt       DateTime        @default(now())

  @@index([requestId])
}


// ============================================================================
// EXPORT MODULE: SHIPPING & QUOTATIONS
// ============================================================================

model ExportCountry {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  code      String       // ISO 3166-1 alpha-2 (e.g., "LK")
  isActive  Boolean      @default(true)
  ports     ExportPort[]
  quotes    ExportQuoteRequest[]
  createdAt DateTime     @default(now())
  
  @@unique([tenantId, code])
  @@index([tenantId])
}

model ExportPort {
  id             String         @id @default(cuid())
  tenantId       String
  countryId      String
  country        ExportCountry  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name           String
  shippingMethod String         // "RORO" or "CONTAINER"
  shippingCost   Decimal?       // null = Ask for Price
  insuranceCost  Decimal?
  inspectionFee  Decimal?
  isDefault      Boolean        @default(false)
  quotes         ExportQuoteRequest[]
  createdAt      DateTime       @default(now())
  
  @@index([tenantId, countryId])
}

model ExportQuoteRequest {
  id            String          @id @default(cuid())
  tenantId      String
  vehicleId     String
  vehicle       ExportVehicle   @relation(fields: [vehicleId], references: [id])
  customerId    String?
  customer      ExportCustomer? @relation(fields: [customerId], references: [id])
  
  name          String
  email         String
  phone         String?
  address       String?
  
  countryId     String
  country       ExportCountry   @relation(fields: [countryId], references: [id])
  portId        String
  port          ExportPort      @relation(fields: [portId], references: [id])
  
  fobPrice      Decimal?
  shippingCost  Decimal?
  insuranceCost Decimal?
  inspectionFee Decimal?
  totalCIF      Decimal?
  askForPrice   Boolean         @default(false)
  
  status        String          @default("PENDING") // PENDING, CONTACTED, QUOTED, CLOSED
  adminNotes    String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@index([tenantId, status])
}
