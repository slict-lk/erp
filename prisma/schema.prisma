// ============================================================================
// SPARE PARTS PROMOTIONS - Quantity-Based Tiered Discounts
// ============================================================================

model SparePromotion {
  id              String   @id @default(cuid())
  tenantId        String
  
  // Basic Info
  name            String
  description     String?
  code            String?   // Optional promo code
  
  // Promotion Type
  type            String    // AUTOMATIC | CODE | QUANTITY
  discountType    String    // PERCENTAGE | FIXED_AMOUNT
  discountValue   Decimal   @default(0) // For non-tiered promotions
  
  // Targeting Scope
  targetScope     String    @default("ALL") // ALL | CATEGORY | PRODUCT
  targetProducts  String[]  @default([])    // Product IDs when scope is PRODUCT
  targetCategories String[] @default([])    // Category names when scope is CATEGORY
  
  // Constraints
  minimumPurchase Decimal?  // Minimum order amount
  maximumDiscount Decimal?  // Cap on discount amount
  
  // Validity
  startDate       DateTime  @default(now())
  endDate         DateTime?
  isActive        Boolean   @default(true)
  
  // Usage Tracking
  usageCount      Int       @default(0)
  usageLimit      Int?      // null = unlimited
  
  // Stacking
  stackable       Boolean   @default(true) // Can combine with other promotions
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  tiers           SparePromotionTier[]
  
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([isActive])
}

model SparePromotionTier {
  id            String   @id @default(cuid())
  promotionId   String
  promotion     SparePromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  
  minQuantity   Int
  maxQuantity   Int?      // null = unlimited (e.g., 100+)
  discountType  String    // PERCENTAGE | FIXED_AMOUNT
  discountValue Decimal
  
  createdAt     DateTime  @default(now())
  
  @@index([promotionId])
}

model SparePartsBranch {
