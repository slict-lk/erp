// SLICT ERP 2025 - Merged Schema
// Includes: Core, Real Estate, CRM, HR, Manufacturing, Healthcare, Auto, Shop + Advanced Agentic AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

