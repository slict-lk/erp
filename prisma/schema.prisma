  @@index([status])
  @@index([tenantId])
}

model Conversation {
  id        String                @id @default(cuid())
  tenantId  String
  userId    String
  title     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]
  models    ConversationModel[]

  @@index([tenantId])
  @@index([userId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  functionCalls  Json?
  tenantId       String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
}

model AIInsight {
  id         String    @id @default(cuid())
  tenantId   String
  type       String
  category   String
  severity   String
  title      String
  message    String
  metadata   Json?
  isRead     Boolean   @default(false)
  isActioned Boolean   @default(false)
  actionedBy String?
  actionedAt DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([tenantId])
  @@index([type])
  @@index([severity])
  @@index([isRead])
}

model MLModel {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  type         String
  version      String
  modelPath    String?
  metrics      Json?
  trainedOn    DateTime?
  trainingData Json?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  predictions  Prediction[]

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
}

model Prediction {
  id          String   @id @default(cuid())
  modelId     String
  entityType  String
  entityId    String?
  prediction  Json
  confidence  Float?
  actualValue Json?
  isCorrect   Boolean?
  tenantId    String
  createdAt   DateTime @default(now())
  model       MLModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([entityType])
  @@index([tenantId])
}

