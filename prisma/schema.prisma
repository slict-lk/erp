generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id              String          @id @default(cuid())
  name            String
  subdomain       String          @unique
  domain          String?         @unique
  status          TenantStatus    @default(ACTIVE)
  plan            String          @default("starter")
  settings        Json?
  logo            String?
  primaryColor    String          @default("#3b82f6")
  companyName     String
  subscriptionEnd DateTime?
  trialEnd        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  properties      Property[]
  propertyAgents  PropertyAgent[]
  users           User[]

  @@index([subdomain])
  @@index([domain])
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String
  avatar            String?
  isActive          Boolean            @default(true)
  isSuperAdmin      Boolean            @default(false)
  tenantId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  modulePermissions Json?
  role              String?            @default("USER")
  employeeId        String?            @unique
  blogPosts         BlogPost[]
  organizedEvents   CalendarEvent[]    @relation("EventOrganizer")
  conversations     Conversation[]     @relation("UserConversations")
  instructorCourses Course[]           @relation("CourseInstructor")
  courseEnrollments CourseEnrollment[] @relation("CourseEnrollments")
  eventAttendance   EventAttendee[]    @relation("EventAttendee")
  assignedChats     LiveChatSession[]  @relation("AssignedChats")
  propertyAgent     PropertyAgent?     @relation("AgentUser")
  assignedTickets   Ticket[]           @relation("AssignedTickets")
  ticketComments    TicketComment[]    @relation("TicketComments")
  employee          Employee?          @relation(fields: [employeeId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([role])
}

model Property {
  id             String                    @id @default(cuid())
  title          String
  description    String?
  address        String
  city           String
  state          String
  zipCode        String
  country        String
  bedrooms       Int?
  bathrooms      Float?
  area           Float?
  price          Float
  currency       String                    @default("USD")
  images         String[]                  @default([])
  tenantId       String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  propertyType   String
  listingType    String
  status         String                    @default("AVAILABLE")
  featured       Boolean                   @default(false)
  latitude       Float?
  longitude      Float?
  verified       Boolean                   @default(false)
  videoUrl       String?
  viewCount      Int                       @default(0)
  virtualTourUrl String?
  neighborhood   NeighborhoodInsight?      @relation("PropertyNeighborhoodInsights")
  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents         PropertyAgentAssignment[] @relation("PropertyAgents")
  amenities      PropertyAmenity[]         @relation("PropertyAmenities")
  documents      PropertyDocument[]        @relation("PropertyDocuments")
  favorites      PropertyFavorite[]        @relation("PropertyFavorites")
  inquiries      PropertyInquiry[]         @relation("PropertyInquiries")
  leases         PropertyLease[]           @relation("PropertyLeases")
  maintenances   PropertyMaintenance[]     @relation("PropertyMaintenances")
  views          PropertyView[]            @relation("PropertyViews")
  viewings       PropertyViewing[]
  virtualTours   VirtualTour[]             @relation("PropertyVirtualTours")

  @@index([tenantId])
  @@index([status])
  @@index([city])
  @@index([propertyType])
  @@index([listingType])
  @@index([price])
  @@index([bedrooms])
  @@index([featured])
  @@index([createdAt])
}

model PropertyViewing {
  id          String   @id @default(cuid())
  propertyId  String
  clientName  String
  clientEmail String
  clientPhone String?
  scheduledAt DateTime
  notes       String?
  createdAt   DateTime @default(now())
  status      String   @default("SCHEDULED")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([scheduledAt])
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  title      String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
  property   Property @relation("PropertyDocuments", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyAmenity {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  description String?
  property    Property @relation("PropertyAmenities", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyLease {
  id              String   @id @default(cuid())
  propertyId      String
  tenantName      String
  tenantEmail     String
  tenantPhone     String?
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Float
  securityDeposit Float?
  status          String   @default("ACTIVE")
  contractUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  property        Property @relation("PropertyLeases", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
}

model PropertyMaintenance {
  id          String    @id @default(cuid())
  propertyId  String
  title       String
  description String
  priority    Priority  @default(MEDIUM)
  status      String    @default("PENDING")
  assignedTo  String?
  cost        Float?
  reportedAt  DateTime  @default(now())
  completedAt DateTime?
  property    Property  @relation("PropertyMaintenances", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
}

model PropertyInquiry {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  property   Property @relation("PropertyInquiries", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
}

model PropertyAgent {
  id            String                    @id @default(cuid())
  tenantId      String
  userId        String?                   @unique
  name          String
  email         String
  phone         String
  licenseNumber String?
  commission    Float?
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?                     @relation("AgentUser", fields: [userId], references: [id])
  properties    PropertyAgentAssignment[]

  @@index([tenantId])
  @@index([email])
}

model PropertyAgentAssignment {
  id         String        @id @default(cuid())
  propertyId String
  agentId    String
  role       String        @default("PRIMARY")
  assignedAt DateTime      @default(now())
  agent      PropertyAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  property   Property      @relation("PropertyAgents", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([agentId])
}

model PropertyFavorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation("PropertyFavorites", fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model SavedSearch {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  criteria           Json
  emailNotifications Boolean  @default(true)
  frequency          String   @default("DAILY")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

model VirtualTour {
  id          String   @id @default(cuid())
  propertyId  String
  title       String
  description String?
  tourType    String
  url         String
  embedCode   String?
  images      String[] @default([])
  thumbnail   String?
  viewCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation("PropertyVirtualTours", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model NeighborhoodInsight {
  id               String   @id @default(cuid())
  propertyId       String   @unique
  walkScore        Int?
  transitScore     Int?
  bikeScore        Int?
  medianIncome     Float?
  populationCount  Int?
  medianAge        Float?
  crimeRate        String?
  schools          Json?
  amenities        Json?
  pointsOfInterest Json?
  publicTransport  Json?
  additionalData   Json?
  lastUpdated      DateTime @default(now())
  property         Property @relation("PropertyNeighborhoodInsights", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  ipAddress  String?
  userAgent  String?
  source     String?
  referrer   String?
  sessionId  String?
  duration   Int?
  viewedAt   DateTime @default(now())
  property   Property @relation("PropertyViews", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([viewedAt])
}

model PropertyComparison {
  id          String   @id @default(cuid())
  userId      String
  propertyIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Customer {
  id             String               @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  type           String               @default("INDIVIDUAL")
  status         String               @default("ACTIVE")
  notes          String?
  tenantId       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  calendarEvents CalendarEvent[]
  messages       IntegrationMessage[]
  invoices       Invoice[]
  leads          Lead[]
  posOrders      POSOrder[]
  salesOrders    SalesOrder[]
  tickets        Ticket[]

  @@index([email])
  @@index([tenantId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  jobTitle  String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  type      String   @default("BUSINESS")
  notes     String?
  tags      String[] @default([])
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([type])
  @@index([tenantId])
}

model Lead {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  jobTitle   String?
  source     String?
  status     String    @default("NEW")
  score      Int       @default(0)
  notes      String?
  customerId String?
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([email])
  @@index([status])
  @@index([tenantId])
}

model Opportunity {
  id          String    @id @default(cuid())
  name        String
  description String?
  amount      Float
  probability Int       @default(50)
  stage       String    @default("PROSPECTING")
  closeDate   DateTime?
  customerId  String?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stage])
  @@index([tenantId])
}

model Quotation {
  id         String    @id @default(cuid())
  number     String    @unique
  customerId String?
  total      Float
  tax        Float     @default(0)
  discount   Float     @default(0)
  grandTotal Float
  status     String    @default("DRAFT")
  validUntil DateTime?
  notes      String?
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([number])
  @@index([status])
  @@index([tenantId])
}

model SalesOrder {
  id         String               @id @default(cuid())
  number     String               @unique
  customerId String
  total      Float
  tax        Float                @default(0)
  discount   Float                @default(0)
  grandTotal Float
  status     String               @default("DRAFT")
  orderDate  DateTime             @default(now())
  notes      String?
  tenantId   String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  messages   IntegrationMessage[]
  invoices   Invoice[]
  customer   Customer             @relation(fields: [customerId], references: [id])

  @@index([number])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  userId    String?
  expiresAt DateTime
  tenantId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  price     Float
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([tenantId])
}

model POSOrder {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  customerId    String?
  subtotal      Float
  tax           Float          @default(0)
  discount      Float          @default(0)
  total         Float
  status        String         @default("PENDING")
  paymentMethod String?
  notes         String?
  tenantId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customer      Customer?      @relation(fields: [customerId], references: [id])
  items         POSOrderItem[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model POSOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  total     Float
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     POSOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation("POSOrderItems", fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([tenantId])
}

model IntegrationMessage {
  id            String      @id @default(cuid())
  platform      String
  direction     String      @default("OUTBOUND")
  senderId      String
  senderName    String?
  recipientId   String
  recipientName String?
  messageType   String      @default("TEXT")
  content       String
  status        String      @default("SENT")
  readAt        DateTime?
  customerId    String?
  salesOrderId  String?
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer?   @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])

  @@index([tenantId])
  @@index([platform])
  @@index([direction])
  @@index([status])
  @@index([customerId])
  @@index([salesOrderId])
}

model Vendor {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  website        String?
  taxId          String?
  paymentTerms   String?
  creditLimit    Float?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  zipCode        String?
  country        String?
  contactPerson  String?
  contactPhone   String?
  contactEmail   String?
  notes          String?
  isActive       Boolean         @default(true)
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([email])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  orderNumber  String              @unique
  vendorId     String
  status       String              @default("DRAFT")
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  subtotal     Float
  tax          Float               @default(0)
  total        Float
  notes        String?
  tenantId     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  items        PurchaseOrderItem[]

  @@index([orderNumber])
  @@index([vendorId])
  @@index([status])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Float
  total           Float
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
}

model Account {
  id        String      @id @default(cuid())
  code      String
  name      String
  type      AccountType
  currency  String      @default("USD")
  balance   Float       @default(0)
  parentId  String?
  tenantId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  parent    Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountHierarchy")

  @@unique([code, tenantId])
  @@index([type])
  @@index([tenantId])
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  type         InvoiceType   @default(SALES)
  status       InvoiceStatus @default(DRAFT)
  customerId   String
  salesOrderId String?
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  subtotal     Float
  tax          Float         @default(0)
  discount     Float         @default(0)
  total        Float
  amountPaid   Float         @default(0)
  amountDue    Float
  notes        String?
  terms        String?
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customer     Customer      @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([number])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Float
  unitPrice   Float
  tax         Float    @default(0)
  discount    Float    @default(0)
  total       Float
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Float
  method      PaymentMethod @default(CASH)
  reference   String?
  notes       String?
  paymentDate DateTime      @default(now())
  tenantId    String
  createdAt   DateTime      @default(now())
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([tenantId])
}

model Expense {
  id          String        @id @default(cuid())
  description String
  amount      Float
  category    String
  status      ExpenseStatus @default(DRAFT)
  employeeId  String?
  expenseDate DateTime
  receipt     String?
  notes       String?
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employee    Employee?     @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([employeeId])
  @@index([category])
  @@index([tenantId])
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  sku                String              @unique
  barcode            String?
  description        String?
  type               ProductType         @default(STORABLE)
  category           String?
  costPrice          Float               @default(0)
  salePrice          Float
  stockQty           Float               @default(0)
  minStockQty        Float               @default(0)
  isActive           Boolean             @default(true)
  images             String[]            @default([])
  tenantId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cartItems          CartItem[]
  invoiceLines       InvoiceLine[]
  posOrderItems      POSOrderItem[]      @relation("POSOrderItems")
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@index([sku])
  @@index([category])
  @@index([isActive])
  @@index([tenantId])
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  address        String?
  city           String?
  country        String?
  isActive       Boolean         @default(true)
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]

  @@index([code])
  @@index([tenantId])
}

model StockMovement {
  id           String       @id @default(cuid())
  productId    String
  warehouseId  String
  type         MovementType
  quantity     Float
  reference    String?
  notes        String?
  movementDate DateTime     @default(now())
  tenantId     String
  createdAt    DateTime     @default(now())
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([movementDate])
  @@index([tenantId])
}

model ManufacturingOrder {
  id                String              @id @default(cuid())
  orderNumber       String              @unique
  productId         String?
  productName       String
  quantityToProduce Float
  quantityProduced  Float               @default(0)
  status            ManufacturingStatus @default(DRAFT)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?
  tenantId          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([tenantId])
}

model Department {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  managerId   String?
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@index([code])
  @@index([tenantId])
}

model Employee {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String         @unique
  phone         String?
  employeeId    String         @unique
  departmentId  String?
  position      String
  type          EmploymentType @default(FULL_TIME)
  hireDate      DateTime
  salary        Float?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  isActive      Boolean        @default(true)
  tenantId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attendances   Attendance[]
  department    Department?    @relation(fields: [departmentId], references: [id])
  expenses      Expense[]
  leaveRequests LeaveRequest[]
  timesheets    Timesheet[]
  user          User?

  @@index([employeeId])
  @@index([email])
  @@index([departmentId])
  @@index([isActive])
  @@index([tenantId])
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?
  tenantId   String
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([tenantId])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  days       Float
  reason     String?
  status     LeaveStatus @default(PENDING)
