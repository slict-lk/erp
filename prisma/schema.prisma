model EmailCampaignRecipient {
  id         String        @id @default(cuid())
  campaignId String
  email      String
  name       String?
  status     String        @default("PENDING")
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  tenantId   String
