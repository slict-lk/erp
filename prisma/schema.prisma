// Language Model Management
model LanguageModel {
  id              String                 @id @default(cuid())
  tenantId        String
  name            String
  provider        ModelProvider
  modelId         String // e.g., "gpt-4", "llama2", "qwen2.5:0.5b"
  description     String?
  capabilities    String[]               @default([]) // e.g., ["chat", "completion", "function_calling"]
  contextWindow   Int                    @default(4096)
  maxTokens       Int?
  temperature     Float                  @default(0.7)
  topP            Float                  @default(1.0)
  frequencyPenalty Float                 @default(0.0)
  presencePenalty Float                  @default(0.0)
  apiEndpoint     String?
  apiKey          String? // Encrypted
  isDefault       Boolean                @default(false)
  isActive        Boolean                @default(true)
  config          Json? // Additional provider-specific config
  metadata        Json? // Model metadata (version, training date, etc.)
  usageCount      Int                    @default(0)
  totalTokens     BigInt                 @default(0)
  totalCost       Float                  @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  conversations   ConversationModel[]
  modelUsages     ModelUsage[]
  prompts         PromptTemplate[]

  @@unique([tenantId, modelId, provider])
  @@index([tenantId])
  @@index([provider])
  @@index([isActive])
  @@index([isDefault])
}

// Track which models are used in conversations
model ConversationModel {
  id              String         @id @default(cuid())
  conversationId  String
  modelId         String
  usedAt          DateTime       @default(now())
  tokensUsed      Int            @default(0)
  cost            Float          @default(0)
  tenantId        String
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  model           LanguageModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([modelId])
  @@index([tenantId])
}

// Prompt templates for different use cases
model PromptTemplate {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  category    PromptCategory @default(GENERAL)
  template    String // The actual prompt template with variables
  variables   String[]       @default([]) // List of variable names used in template
  modelId     String?
  isSystem    Boolean        @default(false) // System-level vs user-created
  isActive    Boolean        @default(true)
  usageCount  Int            @default(0)
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  model       LanguageModel? @relation(fields: [modelId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
}

// Track model usage and costs
model ModelUsage {
  id              String        @id @default(cuid())
  tenantId        String
  modelId         String
  conversationId  String?
  userId          String?
  operation       String // "chat", "completion", "embedding", etc.
  promptTokens    Int           @default(0)
  completionTokens Int          @default(0)
  totalTokens     Int           @default(0)
  cost            Float         @default(0)
  latencyMs       Int? // Response time in milliseconds
  success         Boolean       @default(true)
  errorMessage    String?
  metadata        Json? // Additional context
  createdAt       DateTime      @default(now())
  model           LanguageModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([modelId])
  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

// Fine-tuning jobs for custom models
model FineTuningJob {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  baseModel       String
  status          FineTuningStatus @default(PENDING)
  trainingFile    String
  validationFile  String?
  hyperparameters Json?
  fineTunedModel  String? // ID of the resulting fine-tuned model
  trainingMetrics Json?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([status])
}

// Model evaluation and benchmarks
model ModelEvaluation {
  id          String   @id @default(cuid())
  tenantId    String
  modelId     String?
  modelName   String
  provider    String
  testSet     String // Name or ID of test dataset
  accuracy    Float?
  precision   Float?
  recall      Float?
  f1Score     Float?
  bleuScore   Float?
  perplexity  Float?
  latencyMs   Int?
  costPerToken Float?
  metrics     Json? // Additional custom metrics
  notes       String?
  evaluatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([modelName])
  @@index([provider])
}

enum ModelProvider {
  OPENAI
  ANTHROPIC
  GROQ
  OLLAMA
  HUGGINGFACE
  COHERE
  GOOGLE
  AZURE
  AWS_BEDROCK
  CUSTOM
}

enum PromptCategory {
