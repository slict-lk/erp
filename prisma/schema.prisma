model LiveChatSession {
  id           String            @id @default(cuid())
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  ipAddress    String?
  userAgent    String?
  status       ChatStatus        @default(ACTIVE)
  assignedToId String?
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  tenantId     String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     LiveChatMessage[]
  assignedTo   User?             @relation("AssignedChats", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([tenantId])
}

model LiveChatMessage {
  id         String          @id @default(cuid())
  sessionId  String
  content    String
  senderType String
  senderId   String?
  senderName String
  isRead     Boolean         @default(false)
  tenantId   String
  sentAt     DateTime        @default(now())
  session    LiveChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenantId])
}

model KnowledgeArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String
  content         String
  excerpt         String?
  category        String?
  tags            String[]  @default([])
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  authorId        String?
  viewCount       Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([slug, tenantId])
  @@index([category])
  @@index([isPublished])
  @@index([tenantId])
}

model QualityInspection {
  id             String   @id @default(cuid())
  inspectionType String
  subject        String
  description    String?
  productId      String?
  orderNumber    String?
  inspectorId    String?
  inspectorName  String
  status         String   @default("PENDING")
  score          Int?
  findings       Json?
  passedChecks   Int      @default(0)
  failedChecks   Int      @default(0)
  totalChecks    Int      @default(0)
  notes          String?
  inspectionDate DateTime @default(now())
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([inspectionType])
  @@index([tenantId])
}

model AIAgent {
  id             String           @id @default(cuid())
  tenantId       String
  name           String
  type           AgentType
  description    String?
  config         Json?
  isActive       Boolean          @default(true)
  tasksCompleted Int              @default(0)
  successRate    Float?
  lastRunAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  executions     AgentExecution[]

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
}

model AgentExecution {
  id          String               @id @default(cuid())
  agentId     String
  status      AgentExecutionStatus
  input       Json?
  output      Json?
  error       String?
  duration    Int?
  tenantId    String
  startedAt   DateTime             @default(now())
  completedAt DateTime?
  agent       AIAgent              @relation(fields: [agentId], references: [id], onDelete: Cascade)

