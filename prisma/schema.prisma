  address     String?
  city        String?
  phone       String?
  email       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, code])
  @@index([tenantId])
}

model CustomerCreditTransaction {
