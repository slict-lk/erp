// ============================================================================
// CORE: Tenant & User
// ============================================================================

model Tenant {
  id           String       @id @default(cuid())
  name         String
  subdomain    String       @unique
  domain       String?      @unique
  status       TenantStatus @default(ACTIVE)
  plan         String       @default("starter")
  settings     Json?
  logo         String?
  primaryColor String       @default("#3b82f6")
  companyName  String
  enabledModules String[]   @default([])

  subscriptionEnd DateTime?
  trialEnd        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users          User[]
  properties     Property[]
  propertyAgents PropertyAgent[]
  sparePartsConfig SparePartsConfig[]
  shopTaxCategories ShopTaxCategory[]
  moduleAccessRequests ModuleAccessRequest[]

  @@index([subdomain])
  @@index([domain])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  password     String
  name         String
  avatar       String?
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  role              String? @default("USER")
  
  // Dynamic Role Relation
  userRoleId        String?
  userRole          Role?   @relation(fields: [userRoleId], references: [id])
  
  modulePermissions Json?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  propertyAgent     PropertyAgent?     @relation("AgentUser")
  blogPosts         BlogPost[]
  organizedEvents   CalendarEvent[]    @relation("EventOrganizer")
  eventAttendance   EventAttendee[]    @relation("EventAttendee")
  instructorCourses Course[]           @relation("CourseInstructor")
  courseEnrollments CourseEnrollment[] @relation("CourseEnrollments")
  ticketComments    TicketComment[]    @relation("TicketComments")
  assignedTickets   Ticket[]           @relation("AssignedTickets")
  assignedChats     LiveChatSession[]  @relation("AssignedChats")
  conversations     Conversation[]     @relation("UserConversations")
  doctorVisits      MedicalVisit[]     @relation("DoctorVisits")
  assignedVehicleRequests VehicleRequest[] @relation("AssignedVehicleRequests")
  
  employeeId        String?            @unique
  employee          Employee?          @relation(fields: [employeeId], references: [id])

  // Module Access Request relations
  moduleRequestsCreated   ModuleAccessRequest[] @relation("RequestedBy")
  moduleRequestsProcessed ModuleAccessRequest[] @relation("ProcessedBy")

  @@index([tenantId])
  @@index([email])
  @@index([role])
}

// ============================================================================
// MODULE ACCESS REQUESTS
// ============================================================================

model ModuleAccessRequest {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                @relation("RequestedBy", fields: [requestedById], references: [id])
  moduleId      String
  action        ModuleRequestAction
  status        ModuleRequestStatus @default(PENDING)
  reason        String?
  adminNotes    String?
  processedById String?
  processedBy   User?               @relation("ProcessedBy", fields: [processedById], references: [id])
  processedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([tenantId, moduleId, status])
  @@index([tenantId])
  @@index([status])
  @@index([requestedById])
}

// ============================================================================
// REAL ESTATE
// ============================================================================

model Property {
  id             String                    @id @default(cuid())
  title          String
  description    String?
  propertyType   String
  listingType    String
  address        String
  city           String
  state          String
  zipCode        String
  country        String
  bedrooms       Int?
  bathrooms      Float?
  area           Float?
  price          Float
  currency       String                    @default("USD")
  status         String                    @default("AVAILABLE")
  images         String[]                  @default([])
  latitude       Float?
  longitude      Float?
  videoUrl       String?
  virtualTourUrl String?
  featured       Boolean                   @default(false)
  verified       Boolean                   @default(false)
  viewCount      Int                       @default(0)

  tenantId       String
  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  viewings       PropertyViewing[]
  documents      PropertyDocument[]        @relation("PropertyDocuments")
  amenities      PropertyAmenity[]         @relation("PropertyAmenities")
  leases         PropertyLease[]           @relation("PropertyLeases")
  maintenances   PropertyMaintenance[]     @relation("PropertyMaintenances")
  inquiries      PropertyInquiry[]         @relation("PropertyInquiries")
  agents         PropertyAgentAssignment[] @relation("PropertyAgents")
  favorites      PropertyFavorite[]        @relation("PropertyFavorites")
  virtualTours   VirtualTour[]             @relation("PropertyVirtualTours")
  neighborhood   NeighborhoodInsight?      @relation("PropertyNeighborhoodInsights")
  views          PropertyView[]            @relation("PropertyViews")

  @@index([tenantId])
  @@index([status])
  @@index([city])
  @@index([propertyType])
  @@index([listingType])
  @@index([price])
}

model PropertyViewing {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientName  String
  clientEmail String
  clientPhone String?
  scheduledAt DateTime
  status      String   @default("SCHEDULED")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([propertyId])
  @@index([scheduledAt])
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation("PropertyDocuments", fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())

  @@index([propertyId])
}

model PropertyAmenity {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation("PropertyAmenities", fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  description String?

  @@index([propertyId])
}

model PropertyLease {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation("PropertyLeases", fields: [propertyId], references: [id], onDelete: Cascade)
  tenantName      String
  tenantEmail     String
  tenantPhone     String?
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Float
  securityDeposit Float?
  status          String   @default("ACTIVE")
  contractUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
}

model PropertyMaintenance {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation("PropertyMaintenances", fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String
  priority    Priority  @default(MEDIUM)
  status      String    @default("PENDING")
  assignedTo  String?
  cost        Float?
  reportedAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([propertyId])
  @@index([status])
}

model PropertyInquiry {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation("PropertyInquiries", fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("NEW")
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([status])
}

model PropertyAgent {
  id            String                    @id @default(cuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?                   @unique
  user          User?                     @relation("AgentUser", fields: [userId], references: [id])
  name          String
  email         String
  phone         String
  licenseNumber String?
  commission    Float?
  isActive      Boolean                   @default(true)
  properties    PropertyAgentAssignment[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([tenantId])
  @@index([email])
}

model PropertyAgentAssignment {
  id         String        @id @default(cuid())
  propertyId String
  property   Property      @relation("PropertyAgents", fields: [propertyId], references: [id], onDelete: Cascade)
  agentId    String
  agent      PropertyAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role       String        @default("PRIMARY")
  assignedAt DateTime      @default(now())

  @@index([propertyId])
  @@index([agentId])
}

model PropertyFavorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  property   Property @relation("PropertyFavorites", fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model SavedSearch {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  criteria           Json
  emailNotifications Boolean  @default(true)
  frequency          String   @default("DAILY")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

model VirtualTour {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation("PropertyVirtualTours", fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  tourType    String
  url         String
  embedCode   String?
  images      String[] @default([])
  thumbnail   String?
  viewCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
}

model NeighborhoodInsight {
  id               String   @id @default(cuid())
  propertyId       String   @unique
  property         Property @relation("PropertyNeighborhoodInsights", fields: [propertyId], references: [id], onDelete: Cascade)
  walkScore        Int?
  transitScore     Int?
  bikeScore        Int?
  medianIncome     Float?
  populationCount  Int?
  medianAge        Float?
  crimeRate        String?
  schools          Json?
  amenities        Json?
  pointsOfInterest Json?
  publicTransport  Json?
  additionalData   Json?
  lastUpdated      DateTime @default(now())

  @@index([propertyId])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation("PropertyViews", fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  ipAddress  String?
  userAgent  String?
  source     String?
  referrer   String?
  sessionId  String?
  duration   Int?
  viewedAt   DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
  @@index([viewedAt])
}

model PropertyComparison {
  id          String   @id @default(cuid())
  userId      String
  propertyIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// SALES & CRM
// ============================================================================

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  type      String   @default("INDIVIDUAL")
  status    String   @default("ACTIVE")
  notes     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders    SalesOrder[]
  invoices       Invoice[]
  leads          Lead[]
  calendarEvents CalendarEvent[]
  posOrders      POSOrder[]
  tickets        Ticket[]
  messages       IntegrationMessage[]

  @@index([email])
  @@index([tenantId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  jobTitle  String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  type      String   @default("BUSINESS")
  notes     String?  @db.Text
  tags      String[] @default([])
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([type])
  @@index([tenantId])
}

model Lead {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  jobTitle   String?
  source     String?
  status     String    @default("NEW")
  score      Int       @default(0)
  notes      String?
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([tenantId])
}

model Opportunity {
  id          String    @id @default(cuid())
  name        String
  description String?
  amount      Float
  probability Int       @default(50)
  stage       String    @default("PROSPECTING")
  closeDate   DateTime?
  customerId  String?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stage])
  @@index([tenantId])
}

model Quotation {
  id         String    @id @default(cuid())
  number     String    @unique
  customerId String?
  total      Float
  tax        Float     @default(0)
  discount   Float     @default(0)
  grandTotal Float
  status     String    @default("DRAFT")
  validUntil DateTime?
  notes      String?
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([number])
  @@index([status])
  @@index([tenantId])
}

model SalesOrder {
  id         String               @id @default(cuid())
  number     String               @unique
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id])
  total      Float
  tax        Float                @default(0)
  discount   Float                @default(0)
  grandTotal Float
  status     String               @default("DRAFT")
  orderDate  DateTime             @default(now())
  notes      String?
  tenantId   String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  invoices   Invoice[]
  messages   IntegrationMessage[]

  @@index([number])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  userId    String?
  expiresAt DateTime
  tenantId  String
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([tenantId])
}

model POSOrder {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal      Float
  tax           Float          @default(0)
  discount      Float          @default(0)
  total         Float
  status        String         @default("PENDING")
  paymentMethod String?
  notes         String?
  tenantId      String
  items         POSOrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

model POSOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     POSOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation("POSOrderItems", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Float
  total     Float
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([tenantId])
}

model IntegrationMessage {
  id            String      @id @default(cuid())
  platform      String
  direction     String      @default("OUTBOUND")
  senderId      String
  senderName    String?
  recipientId   String
  recipientName String?
  messageType   String      @default("TEXT")
  content       String      @db.Text
  status        String      @default("SENT")
  readAt        DateTime?
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  salesOrderId  String?
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId])
  @@index([platform])
  @@index([direction])
  @@index([status])
  @@index([customerId])
  @@index([salesOrderId])
}

// ============================================================================
// PURCHASING
// ============================================================================

model Vendor {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  website        String?
  taxId          String?
  paymentTerms   String?
  creditLimit    Float?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  zipCode        String?
  country        String?
  contactPerson  String?
  contactPhone   String?
  contactEmail   String?
  notes          String?
  isActive       Boolean         @default(true)
  tenantId       String
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId])
  @@index([email])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  orderNumber  String              @unique
  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  status       String              @default("DRAFT")
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  subtotal     Float
  tax          Float               @default(0)
  total        Float
  notes        String?
  items        PurchaseOrderItem[]
  tenantId     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([orderNumber])
  @@index([vendorId])
  @@index([status])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Float
  total           Float
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

// ============================================================================
// ACCOUNTING
// ============================================================================

model Account {
  id        String      @id @default(cuid())
  code      String
  name      String
  type      AccountType
  currency  String      @default("USD")
  balance   Float       @default(0)
  parentId  String?
  parent    Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountHierarchy")
  tenantId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([code, tenantId])
  @@index([type])
  @@index([tenantId])
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  type         InvoiceType   @default(SALES)
  status       InvoiceStatus @default(DRAFT)
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  subtotal     Float
  tax          Float         @default(0)
  discount     Float         @default(0)
  total        Float
  amountPaid   Float         @default(0)
  amountDue    Float
  notes        String?
  terms        String?
  tenantId     String
  payments     Payment[]
  lines        InvoiceLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([number])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  unitPrice   Float
  tax         Float    @default(0)
  discount    Float    @default(0)
  total       Float

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amount      Float
  method      PaymentMethod @default(CASH)
  reference   String?
  notes       String?
  paymentDate DateTime      @default(now())
  tenantId    String
  createdAt   DateTime      @default(now())

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([tenantId])
}

model Expense {
  id          String        @id @default(cuid())
  description String
  amount      Float
  category    String
  status      ExpenseStatus @default(DRAFT)
  employeeId  String?
  employee    Employee?     @relation(fields: [employeeId], references: [id])
  expenseDate DateTime
  receipt     String?
  notes       String?
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([employeeId])
  @@index([category])
  @@index([tenantId])
}

// ============================================================================
// INVENTORY
// ============================================================================

model Product {
  id                 String              @id @default(cuid())
  name               String
  sku                String              @unique
  barcode            String?
  description        String?
  type               ProductType         @default(STORABLE)
  category           String?
  costPrice          Float               @default(0)
  salePrice          Float
  stockQty           Float               @default(0)
  minStockQty        Float               @default(0)
  isActive           Boolean             @default(true)
  images             String[]            @default([])
  tenantId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  
  // Relations
  stockMovements     StockMovement[]
  invoiceLines       InvoiceLine[]
  automotivePart     AutomotivePart?
  cartItems          CartItem[]
  posOrderItems      POSOrderItem[]      @relation("POSOrderItems")
  purchaseOrderItems PurchaseOrderItem[]

  @@index([sku])
  @@index([category])
  @@index([isActive])
  @@index([tenantId])
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  address        String?
  city           String?
  country        String?
  isActive       Boolean         @default(true)
  tenantId       String
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([code])
  @@index([tenantId])
}

model StockMovement {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  type         MovementType
  quantity     Float
  reference    String?
  notes        String?
  movementDate DateTime     @default(now())
  tenantId     String
  createdAt    DateTime     @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([movementDate])
  @@index([tenantId])
}

// ============================================================================
// MANUFACTURING
// ============================================================================

model ManufacturingOrder {
  id                String              @id @default(cuid())
  orderNumber       String              @unique
  productId         String?
  productName       String
  quantityToProduce Float
  quantityProduced  Float               @default(0)
  status            ManufacturingStatus @default(DRAFT)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?             @db.Text
  tenantId          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([tenantId])
}

// ============================================================================
// HR MODULE (RESTORED)
// ============================================================================

model Department {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  managerId   String?
  tenantId    String
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([code])
  @@index([tenantId])
}

model Employee {
  id           String         @id @default(cuid())
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  employeeId   String         @unique
  user         User?
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  position     String
  type         EmploymentType @default(FULL_TIME)
  hireDate     DateTime
  salary       Float?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  country      String?
  isActive     Boolean        @default(true)
  tenantId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  expenses      Expense[]
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  timesheets    Timesheet[]

  @@index([employeeId])
  @@index([email])
  @@index([departmentId])
  @@index([isActive])
  @@index([tenantId])
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?
  tenantId   String
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([tenantId])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  days       Float
  reason     String?     @db.Text
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  tenantId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([tenantId])
}

model Timesheet {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  date        DateTime
  hours       Float
  description String?  @db.Text
  billable    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([projectId])
  @@index([taskId])
  @@index([date])
  @@index([tenantId])
}

// ============================================================================
// PROJECT MANAGEMENT
// ============================================================================

model Project {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  description    String?
  status         ProjectStatus   @default(PLANNING)
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?
  customerId     String?
  managerId      String?
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  tasks          Task[]
  calendarEvents CalendarEvent[]
  timesheets     Timesheet[]

  @@index([code])
  @@index([status])
  @@index([tenantId])
}

model Task {
  id             String      @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus  @default(TODO)
  priority       Priority    @default(MEDIUM)
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId     String?
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float?
  tenantId       String
  timesheets     Timesheet[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([tenantId])
}

// ============================================================================
// CONSTRUCTION
// ============================================================================

model ConstructionJob {
  id            String                 @id @default(cuid())
  jobNumber     String                 @unique
  projectName   String
  description   String?                @db.Text
  siteAddress   String
  city          String
  state         String
  clientName    String
  clientEmail   String?
  clientPhone   String?
  startDate     DateTime
  endDate       DateTime?
  estimatedCost Float
  actualCost    Float                  @default(0)
  status        ConstructionStatus     @default(QUEUED)
  tenantId      String
  subcontracts  Subcontract[]
  materials     ConstructionMaterial[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([jobNumber])
  @@index([status])
  @@index([tenantId])
}

model Subcontract {
  id              String          @id @default(cuid())
  jobId           String
  job             ConstructionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contractorName  String
  contractorEmail String?
  contractorPhone String?
  workDescription String          @db.Text
  contractValue   Float
  paidAmount      Float           @default(0)
  startDate       DateTime
  endDate         DateTime?
  status          String          @default("PENDING")
  tenantId        String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([tenantId])
}

model ConstructionMaterial {
  id           String          @id @default(cuid())
  jobId        String
  job          ConstructionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  materialName String
  quantity     Float
  unit         String
  unitCost     Float
  totalCost    Float
  supplier     String?
  deliveryDate DateTime?
  tenantId     String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([jobId])
  @@index([tenantId])
}

// ============================================================================
// HELPDESK
// ============================================================================

model Ticket {
  id          String        @id @default(cuid())
  number      String        @unique
  subject     String
  description String
  status      TicketStatus  @default(NEW)
  priority    Priority      @default(MEDIUM)
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignedTo  User?         @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  tenantId    String
  comments    TicketComment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([number])
  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([assigneeId])
  @@index([tenantId])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment    String   @db.Text
  authorId   String?
  author     User?    @relation("TicketComments", fields: [authorId], references: [id], onDelete: SetNull)
  isInternal Boolean  @default(false)
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ticketId])
  @@index([authorId])
  @@index([tenantId])
}

// ============================================================================
// CMS & LMS
// ============================================================================

model WebPage {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String
  isPublished    Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([tenantId])
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String
  content        String    @db.Text
  excerpt        String?
  featuredImage  String?
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  categories     String[]  @default([])
  tags           String[]  @default([])
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]  @default([])
  viewCount      Int       @default(0)
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([slug, tenantId])
  @@index([authorId])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([tenantId])
}

model Course {
  id           String             @id @default(cuid())
  title        String
  slug         String
  description  String?            @db.Text
  coverImage   String?
  instructorId String?
  instructor   User?              @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  isFree       Boolean            @default(false)
  price        Float?
  level        CourseLevel        @default(BEGINNER)
  duration     Int?
  language     String             @default("English")
  isPublished  Boolean            @default(false)
  publishedAt  DateTime?
  category     String?
  tags         String[]           @default([])
  tenantId     String
  lessons      Lesson[]
  enrollments  CourseEnrollment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([slug, tenantId])
  @@index([instructorId])
  @@index([isPublished])
  @@index([level])
  @@index([tenantId])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  content     String?  @db.Text
  videoUrl    String?
  order       Int      @default(0)
  duration    Int?
  isFree      Boolean  @default(false)
  isPublished Boolean  @default(false)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([order])
  @@index([tenantId])
}

model CourseEnrollment {
  id            String    @id @default(cuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?     @relation("CourseEnrollments", fields: [userId], references: [id], onDelete: SetNull)
  studentName   String?
  studentEmail  String?
  enrolledAt    DateTime  @default(now())
  completedAt   DateTime?
  progress      Int       @default(0)
  paymentStatus String    @default("PENDING")
  amountPaid    Float?
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([courseId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([tenantId])
}

model Survey {
  id          String   @id @default(cuid())
  title       String
  description String?
  questions   Json
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([tenantId])
}

// ============================================================================
// MARKETING & COMMUNITY
// ============================================================================

model SMSCampaign {
  id          String    @id @default(cuid())
  name        String
  message     String
  status      String    @default("DRAFT")
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  String[]  @default([])
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([tenantId])
}

model MarketingEvent {
  id            String               @id @default(cuid())
  title         String
  description   String?              @db.Text
  location      String?
  eventType     String?
  startDate     DateTime
  endDate       DateTime?
  capacity      Int?
  status        MarketingEventStatus @default(DRAFT)
  coverImage    String?
  tenantId      String
  registrations EventRegistration[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([tenantId])
}

model EventRegistration {
  id            String         @id @default(cuid())
  eventId       String
  event         MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  status        String         @default("CONFIRMED")
  registeredAt  DateTime       @default(now())
  tenantId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([attendeeEmail])
  @@index([tenantId])
}

model ForumTopic {
  id          String      @id @default(cuid())
  title       String
  slug        String
  description String?     @db.Text
  category    String?
  tags        String[]    @default([])
  authorId    String?
  authorName  String
  authorEmail String?
  status      TopicStatus @default(OPEN)
  isPinned    Boolean     @default(false)
  viewCount   Int         @default(0)
  tenantId    String
  posts       ForumPost[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([slug, tenantId])
  @@index([category])
  @@index([status])
  @@index([isPinned])
  @@index([tenantId])
}

model ForumPost {
  id          String     @id @default(cuid())
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content     String     @db.Text
  authorId    String?
  authorName  String
  authorEmail String?
  isAnswer    Boolean    @default(false)
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([topicId])
  @@index([isAnswer])
  @@index([tenantId])
}

model EmailCampaign {
  id           String                   @id @default(cuid())
  name         String
  subject      String
  content      String                   @db.Text
  htmlContent  String?                  @db.Text
  status       String                   @default("DRAFT")
  sentCount    Int                      @default(0)
  openedCount  Int                      @default(0)
  clickedCount Int                      @default(0)
  bouncedCount Int                      @default(0)
  scheduledAt  DateTime?
  sentAt       DateTime?
  tenantId     String
  recipients   EmailCampaignRecipient[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([tenantId])
  @@index([status])
}

model EmailCampaignRecipient {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  status     String        @default("PENDING")
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  tenantId   String

  @@index([campaignId])
  @@index([email])
  @@index([tenantId])
}

// ============================================================================
// HOSPITALITY (Restaurant & Hotel)
// ============================================================================

model RestaurantTable {
  id        String      @id @default(cuid())
  number    String
  capacity  Int
  status    TableStatus @default(AVAILABLE)
  tenantId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([number, tenantId])
  @@index([status])
  @@index([tenantId])
}

model RoomType {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  basePrice     Float
  maxOccupancy  Int         @default(2)
  amenities     String[]    @default([])
  images        String[]    @default([])
  bedType       String?
  sizeSqM       Float?
  
  tenantId      String
  rooms         HotelRoom[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

model HotelRoom {
  id                  String               @id @default(cuid())
  roomNumber          String
  
  // Relation to Type (Configuration)
  roomTypeId          String?
  type                RoomType?            @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  // DEPRECATED FIELDS (Kept to prevent data loss)
  roomType            String?              // Legacy string
  basePrice           Float?               // Moved to RoomType
  maxOccupancy        Int                  @default(2) // Moved to RoomType
  amenities           String[]             @default([]) // Moved to RoomType
  images              String[]             @default([]) // Moved to RoomType
  description         String?              @db.Text     // Moved to RoomType
  bedType             String?              // Moved to RoomType
  
  floor               Int?
  status              RoomStatus           @default(AVAILABLE)
  
  tenantId            String
  branchId            String?
  branch              HotelBranch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  housekeepingStatus  HousekeepingStatus   @default(CLEAN)
  lastCleanedAt       DateTime?
  lastInspectedAt     DateTime?
  lastCleanedBy       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  
  bookings            HotelBooking[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([roomNumber, tenantId])
  @@index([status])
  @@index([roomTypeId])
  @@index([tenantId])
  @@index([branchId])
  @@index([housekeepingStatus])
}

model HotelBooking {
  id               String            @id @default(cuid())
  bookingNumber    String            @unique
  roomId           String
  room             HotelRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestName        String
  guestEmail       String
  guestPhone       String?
  checkIn          DateTime
  checkOut         DateTime
  nights           Int
  guests           Int               @default(1)
  totalAmount      Float
  paidAmount       Float             @default(0)
  status           BookingStatus     @default(CONFIRMED)
  specialRequests  String?           @db.Text
  tenantId         String
  branchId         String?
  branch           HotelBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  checkedInBy      String?
  assignedRoom     String?
  idVerified       Boolean           @default(false)
  paymentMethod    String?
  depositAmount    Float             @default(0)
  guestProfileId   String?
  guestProfile     GuestProfile?     @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  folioCharges     FolioCharge[]
  frontDeskActions FrontDeskAction[]

  @@index([roomId])
  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
  @@index([tenantId])
  @@index([branchId])
  @@index([guestProfileId])
}

model GuestProfile {
  id                  String         @id @default(cuid())
  tenantId            String
  email               String
  phone               String?
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  nationality         String?
  idType              String?
  idNumber            String?
  avatarUrl           String?
  roomPreferences     Json?
  dietaryRestrictions String?
  specialNotes        String?        @db.Text
  isVIP               Boolean        @default(false)
  vipLevel            String?
  loyaltyNumber       String?
  loyaltyPoints       Int            @default(0)
  loyaltyTier         String?
  totalStays          Int            @default(0)
  totalSpend          Float          @default(0)
  lastStayDate        DateTime?
  firstStayDate       DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bookings            HotelBooking[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([lastName])
  @@index([isVIP])
  @@index([loyaltyTier])
}

model FolioCharge {
  id          String       @id @default(cuid())
  bookingId   String
  booking     HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  chargeType  String
  description String
  amount      Float
  quantity    Int          @default(1)
  unitPrice   Float?
  taxAmount   Float        @default(0)
  chargedAt   DateTime     @default(now())
  chargedBy   String?
  isVoided    Boolean      @default(false)
  voidedAt    DateTime?
  voidedBy    String?
  voidReason  String?
  tenantId    String

  @@index([bookingId])
  @@index([chargeType])
  @@index([tenantId])
}

model FrontDeskAction {
  id          String       @id @default(cuid())
  bookingId   String
  booking     HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actionType  String
  performedBy String
  details     Json?
  notes       String?
  tenantId    String
  createdAt   DateTime     @default(now())

  @@index([bookingId])
  @@index([actionType])
  @@index([tenantId])
  @@index([createdAt])
}

model HousekeepingTask {
  id           String       @id @default(cuid())
  roomId       String
  room         HotelRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  taskType     String
  priority     TaskPriority @default(NORMAL)
  status       HkTaskStatus @default(PENDING)
  assignedTo   String?
  assignedAt   DateTime?
  notes        String?
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  verifiedBy   String?
  verifiedAt   DateTime?
  checklist    Json?
  tenantId     String
  branchId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([roomId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([tenantId])
  @@index([scheduledFor])
}

model MaintenanceRequest {
  id            String              @id @default(cuid())
  roomId        String?
  room          HotelRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  location      String?
  category      MaintenanceCategory @default(OTHER)
  description   String              @db.Text
  priority      TaskPriority        @default(NORMAL)
  status        MaintenanceStatus   @default(OPEN)
  reportedBy    String
  assignedTo    String?
  assignedAt    DateTime?
  estimatedCost Float?
  actualCost    Float?
  startedAt     DateTime?
  resolvedAt    DateTime?
  resolution    String?             @db.Text
  photos        String[]            @default([])
  tenantId      String
  branchId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([roomId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([tenantId])
}

model HotelConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  hotelName       String   @default("My Hotel")
  tagline         String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#1a73e8")
  secondaryColor  String   @default("#202124")
  accentColor     String   @default("#f59e0b")
  fontFamily      String   @default("Inter, sans-serif")
  currency        String   @default("LKR")
  heroImageUrl    String?
  heroTitle       String?
  heroSubtitle    String?
  aboutUs         String?  @db.Text
  contactEmail    String?
  contactPhone    String?
  address         String?  @db.Text
  mapEmbedUrl     String?
  facebookUrl     String?
  instagramUrl    String?
  twitterUrl      String?
  youtubeUrl      String?
  footerText      String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model HotelBranch {
  id        String             @id @default(cuid())
  tenantId  String
  name      String
  code      String
  country   String
  city      String
  address   String?            @db.Text
  timezone  String             @default("Asia/Colombo")
  latitude  Float?
  longitude Float?
  currency  String             @default("LKR")
  taxRate   Float              @default(0)
  phone     String?
  email     String?
  isDefault Boolean            @default(false)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  
  rooms     HotelRoom[]
  bookings  HotelBooking[]
  config    HotelBranchConfig?
  pricing   PricingRule[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
}

model HotelBranchConfig {
  id              String      @id @default(cuid())
  branchId        String      @unique
  branch          HotelBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hotelName       String?
  tagline         String?
  logoUrl         String?
  primaryColor    String?
  heroImageUrl    String?
  heroTitle       String?
  heroSubtitle    String?
  aboutUs         String?     @db.Text
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model PricingRule {
  id         String      @id @default(cuid())
  branchId   String
  branch     HotelBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name       String
  roomType   String?
  startDate  DateTime
  endDate    DateTime
  multiplier Float       @default(1.0)
  fixedPrice Float?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([branchId])
  @@index([startDate, endDate])
}

// ============================================================================
// HOTEL SERVICES (Dining, Experiences, Events)
// ============================================================================

model DiningVenue {
  id            String              @id @default(cuid())
  tenantId      String
  name          String
  slug          String
  description   String?             @db.Text
  cuisine       String?
  dressCode     String?
  openingHours  Json?               // { mon: "7AM-10PM", tue: ... }
  priceRange    String?             // "$", "$$", "$$$"
  images        String[]            @default([])
  menuUrl       String?
  phone         String?
  capacity      Int?
  isActive      Boolean             @default(true)
  isFeatured    Boolean             @default(false)
  sortOrder     Int                 @default(0)
  branchId      String?
  reservations  DiningReservation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([isActive])
}

model DiningReservation {
  id                String       @id @default(cuid())
  tenantId          String
  venueId           String
  venue             DiningVenue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservationNumber String       @unique
  guestName         String
  guestEmail        String
  guestPhone        String?
  date              DateTime
  time              String
  partySize         Int
  specialRequests   String?      @db.Text
  status            String       @default("CONFIRMED") // CONFIRMED, CANCELLED, COMPLETED, NO_SHOW
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([tenantId])
  @@index([venueId])
  @@index([date])
  @@index([status])
}

model Experience {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  slug            String
  category        String              // Wellness, Adventure, Leisure, Culture
  description     String?             @db.Text
  duration        String?             // "2 hours", "Half Day"
  price           Float               @default(0)
  images          String[]            @default([])
  includes        String[]            @default([])
  requirements    String?             @db.Text
  maxParticipants Int?
  isActive        Boolean             @default(true)
  isFeatured      Boolean             @default(false)
  sortOrder       Int                 @default(0)
  branchId        String?
  bookings        ExperienceBooking[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
}

model ExperienceBooking {
  id              String      @id @default(cuid())
  tenantId        String
  experienceId    String
  experience      Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  bookingNumber   String      @unique
  guestName       String
  guestEmail      String
  guestPhone      String?
  date            DateTime
  time            String?
  participants    Int         @default(1)
  totalAmount     Float       @default(0)
  specialRequests String?     @db.Text
  status          String      @default("CONFIRMED")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId])
  @@index([experienceId])
  @@index([date])
}

model HotelEvent {
  id            String                   @id @default(cuid())
  tenantId      String
  title         String
  slug          String
  description   String?                  @db.Text
  category      String?                  // Music, Dining, Wellness, Culture
  date          DateTime
  endDate       DateTime?
  time          String?
  location      String?
  images        String[]                 @default([])
  price         Float                    @default(0)
  capacity      Int?
  isPublished   Boolean                  @default(false)
  isFeatured    Boolean                  @default(false)
  branchId      String?
  registrations HotelEventRegistration[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([date])
  @@index([isPublished])
}

model HotelEventRegistration {
  id           String     @id @default(cuid())
  tenantId     String
  eventId      String
  event        HotelEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketNumber String     @unique
  guestName    String
  guestEmail   String
  guestPhone   String?
  ticketCount  Int        @default(1)
  totalAmount  Float      @default(0)
  status       String     @default("CONFIRMED")
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@index([eventId])
}

model ContactInquiry {
  id          String    @id @default(cuid())
  tenantId    String
  firstName   String
  lastName    String
  email       String
  phone       String?
  subject     String?
  message     String    @db.Text
  inquiryType String?   // General, Reservation, Group, Wedding, Corporate
  status      String    @default("NEW") // NEW, READ, REPLIED, CLOSED
  assignedTo  String?
  notes       String?   @db.Text
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// SYSTEM & AUTOMATION (RESTORED)
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  permissions Json
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@unique([tenantId, code])
  @@index([code])
  @@index([tenantId])
}

model QualityCheck {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      QualityCheckStatus @default(PENDING)
  productId   String?
  checkDate   DateTime           @default(now())
  inspector   String?
  results     Json?
  tenantId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
  @@index([productId])
  @@index([tenantId])
}

model AutomationRule {
  id            String                @id @default(cuid())
  name          String
  description   String?
  triggerType   TriggerType
  triggerConfig Json
  conditions    Json?
  actions       Json
  isActive      Boolean               @default(true)
  lastRunAt     DateTime?
  tenantId      String
  executions    AutomationExecution[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive])
  @@index([triggerType])
  @@index([tenantId])
}

model AutomationExecution {
  id          String          @id @default(cuid())
  ruleId      String
  rule        AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status      ExecutionStatus
  triggerData Json?
  results     Json?
  error       String?
  executedAt  DateTime        @default(now())
  tenantId    String

  @@index([ruleId])
  @@index([status])
  @@index([executedAt])
  @@index([tenantId])
}

model IntegrationLog {
  id           String            @id @default(cuid())
  integration  String
  action       String
  status       IntegrationStatus
  requestData  Json?
  responseData Json?
  errorMessage String?           @db.Text
  tenantId     String
  createdAt    DateTime          @default(now())

  @@index([integration])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model CalendarEvent {
  id              String          @id @default(cuid())
  title           String
  description     String?         @db.Text
  location        String?
  eventType       EventType       @default(MEETING)
  status          EventStatus     @default(SCHEDULED)
  startTime       DateTime
  endTime         DateTime
  isAllDay        Boolean         @default(false)
  organizerId     String
  organizer       User            @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attendees       EventAttendee[]
  reminderMinutes Int?
  notes           String?         @db.Text
  tenantId        String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizerId])
  @@index([customerId])
  @@index([projectId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([tenantId])
}

model EventAttendee {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation("EventAttendee", fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  name      String?
  status    String        @default("pending")
  tenantId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([eventId])
  @@index([userId])
  @@index([tenantId])
}

model LiveChatSession {
  id           String            @id @default(cuid())
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  ipAddress    String?
  userAgent    String?
  status       ChatStatus        @default(ACTIVE)
  assignedToId String?
  assignedTo   User?             @relation("AssignedChats", fields: [assignedToId], references: [id], onDelete: SetNull)
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  tenantId     String
  messages     LiveChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([tenantId])
}

model LiveChatMessage {
  id         String          @id @default(cuid())
  sessionId  String
  session    LiveChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content    String          @db.Text
  senderType String
  senderId   String?
  senderName String
  isRead     Boolean         @default(false)
  tenantId   String
  sentAt     DateTime        @default(now())

  @@index([sessionId])
  @@index([tenantId])
}

model KnowledgeArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String
  content         String    @db.Text
  excerpt         String?
  category        String?
  tags            String[]  @default([])
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  authorId        String?
  viewCount       Int       @default(0)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([slug, tenantId])
  @@index([category])
  @@index([isPublished])
  @@index([tenantId])
}

model QualityInspection {
  id             String   @id @default(cuid())
  inspectionType String
  subject        String
  description    String?  @db.Text
  productId      String?
  orderNumber    String?
  inspectorId    String?
  inspectorName  String
  status         String   @default("PENDING")
  score          Int?
  findings       Json?
  passedChecks   Int      @default(0)
  failedChecks   Int      @default(0)
  totalChecks    Int      @default(0)
  notes          String?  @db.Text
  inspectionDate DateTime @default(now())
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([inspectionType])
  @@index([tenantId])
}

// ============================================================================
// AGENTIC AI (ADVANCED)
// ============================================================================

model AIAgent {
  id             String           @id @default(cuid())
  tenantId       String
  name           String
  type           AgentType
  description    String?          @db.Text
  config         Json?
  isActive       Boolean          @default(true)
  tasksCompleted Int              @default(0)
  successRate    Float?
  lastRunAt      DateTime?
  executions     AgentExecution[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
}

model LanguageModel {
  id               String              @id @default(cuid())
  tenantId         String
  name             String
  provider         ModelProvider
  modelId          String
  description      String?
  capabilities     String[]            @default([])
  contextWindow    Int                 @default(4096)
  maxTokens        Int?
  temperature      Float               @default(0.7)
  topP             Float               @default(1.0)
  frequencyPenalty Float               @default(0.0)
  presencePenalty  Float               @default(0.0)
  apiEndpoint      String?
  apiKey           String?
  isDefault        Boolean             @default(false)
  isActive         Boolean             @default(true)
  config           Json?
  metadata         Json?
  usageCount       Int                 @default(0)
  totalTokens      BigInt              @default(0)
  totalCost        Float               @default(0)
  lastUsedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  conversations    ConversationModel[]
  modelUsages      ModelUsage[]
  prompts          PromptTemplate[]

  @@unique([tenantId, modelId, provider])
  @@index([tenantId])
  @@index([provider])
  @@index([isActive])
  @@index([isDefault])
}

model AgentExecution {
  id          String               @id @default(cuid())
  agentId     String
  agent       AIAgent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status      AgentExecutionStatus
  input       Json?
  output      Json?
  error       String?              @db.Text
  duration    Int?
  tenantId    String
  startedAt   DateTime             @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
  @@index([tenantId])
}

model Conversation {
  id        String                @id @default(cuid())
  tenantId  String
  userId    String
  user      User                  @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  ConversationMessage[]
  models    ConversationModel[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([tenantId])
  @@index([userId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  functionCalls  Json?
  tenantId       String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([tenantId])
}

model ConversationModel {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  modelId        String
  model          LanguageModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  usedAt         DateTime      @default(now())
  tokensUsed     Int           @default(0)
  cost           Float         @default(0)
  tenantId       String

  @@index([conversationId])
  @@index([modelId])
  @@index([tenantId])
}

model AIInsight {
  id         String    @id @default(cuid())
  tenantId   String
  type       String
  category   String
  severity   String
  title      String
  message    String    @db.Text
  metadata   Json?
  isRead     Boolean   @default(false)
  isActioned Boolean   @default(false)
  actionedBy String?
  actionedAt DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([tenantId])
  @@index([type])
  @@index([severity])
  @@index([isRead])
}

model MLModel {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  type         String
  version      String
  modelPath    String?
  metrics      Json?
  trainedOn    DateTime?
  trainingData Json?
  isActive     Boolean      @default(true)
  predictions  Prediction[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
}

model PromptTemplate {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  category    PromptCategory @default(GENERAL)
  template    String
  variables   String[]       @default([])
  modelId     String?
  model       LanguageModel? @relation(fields: [modelId], references: [id])
  isSystem    Boolean        @default(false)
  isActive    Boolean        @default(true)
  usageCount  Int            @default(0)
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
}

model Prediction {
  id          String   @id @default(cuid())
  modelId     String
  model       MLModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String?
  prediction  Json
  confidence  Float?
  actualValue Json?
  isCorrect   Boolean?
  tenantId    String
  createdAt   DateTime @default(now())

  @@index([modelId])
  @@index([entityType])
  @@index([tenantId])
}

model ModelUsage {
  id               String        @id @default(cuid())
  tenantId         String
  modelId          String
  model            LanguageModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  conversationId   String?
  userId           String?
  operation        String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
