// ============================================================================
// HEALTHCARE
// ============================================================================

model Patient {
  id                     String         @id @default(cuid())
  patientNumber          String         @unique
  firstName              String
  lastName               String
  dateOfBirth            DateTime
  gender                 String
  bloodGroup             String?
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  notificationPreference String         @default("WHATSAPP")
  hasWhatsApp            Boolean        @default(true)
  emergencyContactName   String?
  emergencyContactPhone  String?
  allergies              String?        @db.Text
  chronicConditions      String?        @db.Text
  tenantId               String
  status                 String         @default("ACTIVE")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  
  visits                 MedicalVisit[]
  admissions             Admission[]

  @@index([patientNumber])
  @@index([phone])
  @@index([tenantId])
}

model MedicalVisit {
  id              String         @id @default(cuid())
  visitNumber     Int
  visitDate       DateTime       @default(now())
  type            VisitType      @default(OPD)
  status          VisitStatus    @default(WAITING)
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  doctorId        String?
  doctor          User?          @relation("DoctorVisits", fields: [doctorId], references: [id])
  chiefComplaint  String?        @db.Text
  symptoms        String?        @db.Text
  diagnosis       String?        @db.Text
  notes           String?        @db.Text
  bloodPressure   String?
  temperature     Float?
  pulse           Int?
  weight          Float?
  height          Float?
  invoiceId       String?
  isCompleted     Boolean        @default(false)
  completedAt     DateTime?
  doctorSignature String?
  tenantId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  prescriptions   Prescription[]
  labOrders       LabOrder[]

  @@index([visitDate])
  @@index([status])
  @@index([tenantId])
  @@index([doctorId])
  @@index([patientId])
}

model Prescription {
  id               String       @id @default(cuid())
  visitId          String
  visit            MedicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  productId        String?
  medication       String
  dosage           String
  frequency        String
  duration         String
  instructions     String?
  quantity         Int          @default(1)
  isDispensed      Boolean      @default(false)
  dispensedAt      DateTime?
  dispensedBy      String?
  isSignedByDoctor Boolean      @default(false)
  signedAt         DateTime?
  tenantId         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([visitId])
  @@index([isDispensed])
  @@index([tenantId])
}

model LabTest {
  id             String     @id @default(cuid())
  code           String     @unique
  name           String
  category       String
  description    String?
  price          Float
  productId      String?
  resultTemplate Json?
  isActive       Boolean    @default(true)
  tenantId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  labOrders      LabOrder[]

  @@index([code])
  @@index([category])
  @@index([tenantId])
}

model LabOrder {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  visitId         String
  visit           MedicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  labTestId       String
  labTest         LabTest      @relation(fields: [labTestId], references: [id])
  status          LabOrderStatus @default(PENDING)
  priority        String       @default("NORMAL")
  results         Json?
  resultNotes     String?      @db.Text
  resultDate      DateTime?
  resultEnteredBy String?
  reportUrl       String?
  reportSentAt    DateTime?
  invoiceId       String?
