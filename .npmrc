# pnpm strict version enforcement
package-manager=pnpm@10.0.0

# Node registry configuration
registry=https://registry.npmjs.org/

# Disable frozen lockfile for Vercel builds
frozen-lockfile=false

# Increase network timeout for reliability
fetch-timeout=120000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=5

# Peer dependencies handling
strict-peer-dependencies=false

# pnpm specific settings
shamefully-hoist=false
save-exact=false

# Ensure proper node_modules structure
hoisted-workspace-root=true

# Store settings
store-dir=.pnpm-store

# Virtual store location
virtual-store-dir=node_modules/.pnpm

# Verify store after install
verify-store-integrity=false

# Log level
log-level=info
